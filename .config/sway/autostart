#----- autostarts

set $start_xdg-dirs '[ -x "$(command -v xdg-user-dirs-update)" ] && exec xdg-user-dirs-update'
set $start_xdg_keyboard 'grep -q xkb_layout ~/.config/sway/inputs/inputs.conf || /usr/share/sway/scripts/keyboard.sh'
set $start_autotiling '[ -x "$(command -v autotiling)" ] && autotiling'
set $start_noisetorch '[ -x "$(command -v noisetorch)" ] && noisetorch -u && noisetorch -i'
# set $start_dex '[ -x "$(command -v dex)" ] && gdbus wait --session org.kde.StatusNotifierWatcher && dex -a -e SWAY'


#----- daemons

set $swappy_notify_daemon '[ -x "$(command -v swappy)" ] && $bash_lib/sway/screenshot.sh'
set $calendar_daemon 'calcurse --daemon'
